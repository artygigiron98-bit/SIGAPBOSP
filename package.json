{
  "name": "rekon-bosp-server-secure",
  "version": "1.6.4-json-secure",
  "description": "Backend Node.js + JSON untuk Dashboard Rekonsiliasi Dana BOSP (versi aman)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node --check server.js && npx eslint firestore.rules",
    "lint": "node --check server.js && npx eslint firestore.rules",
