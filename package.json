    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "eslint": "^10.14.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^13.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pdfjs-dist": "^3.11.174"
